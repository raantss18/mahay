<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Automatic updates (Tontolo's model): download verified releases from GitHub. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Install the downloaded update (and, from Mahay HUB, the other Mahay apps) through Android's
         installer; the user confirms an install unless Android lets the installer of record update silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Mahay HUB manages the other apps (D21): this lets an app ask the hub to update it. The
         permission is defined by the hub with protectionLevel="signature": only apps signed with
         Mahay's certificate hold it. -->
    <uses-permission android:name="org.mahay.permission.MANAGE" />
    <queries>
        <package android:name="org.mahay.hub" />
    </queries>

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="${label}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Mahay"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:resizeableActivity="true"
        android:hasFragileUserData="true"
        android:supportsRtl="true">

        <activity
            android:name="org.mahay.shell.MahayActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">

            <meta-data android:name="android.app.lib_name" android:value="${lib}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
