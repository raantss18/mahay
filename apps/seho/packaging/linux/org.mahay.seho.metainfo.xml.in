<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>org.mahay.seho</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Seho</name>
  <summary>Create and present slide decks</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      Seho builds presentations and slide shows: themes, layouts, shapes, pictures,
      tables, charts, transitions and animations. It opens and saves PowerPoint (.pptx) files
      and presents them full screen with a presenter view.
    </p>
    <p>
      Every action is also a command that the command line and AI agents (through MCP) can drive.
    </p>
  </description>
  <launchable type="desktop-id">org.mahay.seho.desktop</launchable>
  <icon type="stock">org.mahay.seho</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/raantss18/mahay>
  <url type="bugtracker">https://github.com/raantss18/mahay/issues</url>
  <url type="help">https://github.com/raantss18/mahay</url>
  <url type="contact">https://github.com/raantss18/mahay/discussions</url>
  <categories>
    <category>Office</category>
    <category>Presentation</category>
  </categories>
  <keywords>
    <keyword>presentation</keyword>
    <keyword>slides</keyword>
    <keyword>slide show</keyword>
    <keyword>pptx</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Slide editor with thumbnails, a process diagram and notes</caption>
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/raantss18/seho/main/docs/images/editor.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#ffc9a8</color>
    <color type="primary" scheme_preference="dark">#b8471f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>seho</binary>
    <mediatype>application/x-seho</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
