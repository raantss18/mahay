[Desktop Entry]
Type=Application
Name=Feo
GenericName=Digital Audio Workstation
Comment=Record, edit and mix audio and MIDI
Exec=feo %F
TryExec=feo
Icon=org.mahay.feo
Terminal=false
StartupNotify=true
StartupWMClass=org.mahay.feo
Categories=AudioVideo;Audio;Midi;Mixer;Sequencer;Recorder;
MimeType=application/x-feo-session;audio/x-wav;audio/wav;audio/vnd.wave;audio/x-aiff;audio/aiff;audio/flac;audio/x-flac;audio/mpeg;audio/midi;audio/x-midi;
Keywords=daw;audio;mixer;recording;multitrack;midi;editor;music;
