<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Drafitra</string>
  <key>CFBundleName</key>
  <string>Drafitra</string>
  <key>CFBundleExecutable</key>
  <string>Drafitra</string>
  <key>CFBundleIdentifier</key>
  <string>org.mahay.drafitra</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>DrafitraVersion</key>
  <string>@VERSION@</string>
  <key>DrafitraBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Drafitra</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Drafitra authors. MIT OR Apache-2.0.</string>

  <!-- Drawing files Drafitra opens (declared here in case macOS has no type for them). -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.mahay.drafitra.dxf</string>
      <key>UTTypeDescription</key>
      <string>Drawing Exchange Format</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>dxf</string></array>
        <key>public.mime-type</key>
        <array><string>image/vnd.dxf</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.mahay.drafitra.dwg</string>
      <key>UTTypeDescription</key>
      <string>Drawing</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>dwg</string></array>
        <key>public.mime-type</key>
        <array><string>image/vnd.dwg</string></array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Drawing Exchange Format</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.mahay.drafitra.dxf</string></array>
      <key>CFBundleTypeIconFile</key>
      <string>Drafitra</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Drawing</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.mahay.drafitra.dwg</string></array>
      <key>CFBundleTypeIconFile</key>
      <string>Drafitra</string>
    </dict>
  </array>

</dict>
</plist>
