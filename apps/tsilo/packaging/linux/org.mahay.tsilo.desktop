[Desktop Entry]
Type=Application
Name=Tsilo
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=tsilo %F
TryExec=tsilo
Icon=org.mahay.tsilo
Terminal=false
