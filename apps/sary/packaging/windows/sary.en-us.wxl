<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides for the setup wizard's WixUI strings, so its pages name the version being installed
  ([SaryVersion] is the full version, pre-release tag included, set in sary.wxs).
-->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}Welcome to the [ProductName] [SaryVersion] Setup Wizard" />
  <String Id="WelcomeDlgDescription" Value="The Setup Wizard will install [ProductName] version [SaryVersion] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." />
  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install [ProductName] [SaryVersion]" />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}Completed the [ProductName] [SaryVersion] Setup Wizard" />
</WixLocalization>
