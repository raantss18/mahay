[Desktop Entry]
Type=Application
Name=Pejy
GenericName=Page Layout
Comment=Lay out magazines, books and print documents
Exec=pejy %F
TryExec=pejy
Icon=org.mahay.pejy
Terminal=false
StartupNotify=true
StartupWMClass=org.mahay.pejy
Categories=Graphics;Publishing;
MimeType=application/x-pejy;application/vnd.adobe.indesign-idml-package;
Keywords=layout;page;desktop publishing;dtp;magazine;book;indesign;idml;typesetting;
