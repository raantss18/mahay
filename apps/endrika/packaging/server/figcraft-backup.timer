# Runs figcraft-backup.service every night (see that file).
#   sudo systemctl enable --now figcraft-backup.timer
#   systemctl list-timers figcraft-backup.timer

[Unit]
Description=Nightly backup of figcraft-server's data directory

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
