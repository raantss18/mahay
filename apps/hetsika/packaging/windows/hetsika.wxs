<?xml version="1.0" encoding="utf-8"?>
<!--
  Hetsika MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build hetsika.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Hetsika"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Hetsika video editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Hetsika is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="HetsikaIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="HetsikaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/raantss18/mahay" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/raantss18/mahay" />
    <Property Id="ARPHELPLINK" Value="https://github.com/raantss18/mahay/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Hetsika" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Hetsika" Level="1">
      <ComponentGroupRef Id="HetsikaFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="HetsikaFiles" Directory="INSTALLFOLDER">
      <Component Id="HetsikaApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="HetsikaExe" Source="$(var.BinDir)\hetsika.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Hetsika"
              Description="Hetsika video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="HetsikaIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\hetsika.exe" Value="[#HetsikaExe]" Type="string" />
      </Component>

      <Component Id="HetsikaCli">
        <File Id="HetsikaCliExe" Source="$(var.BinDir)\hetsika-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
